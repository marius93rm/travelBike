PORT=8787

# Keep the live web adapter disabled unless this deployment is approved.
ENABLE_CFR_WEB_ADAPTER=false
# Required with ENABLE_CFR_WEB_ADAPTER=true only after written CFR approval.
# Keep the reference non-sensitive; never store approval text or credentials here.
# The template value below is rejected and must not be copied as a real reference.
# CFR_WRITTEN_AUTHORIZATION_REF=<approval-document-or-ticket-reference>
CFR_JOURNEY_ENDPOINT=https://bilete.cfrcalatori.ro/ro-RO/Itineraries
CFR_ALLOWED_HOSTS=bilete.cfrcalatori.ro
CFR_PUBLIC_SOURCE_URL=https://bilete.cfrcalatori.ro/ro-RO/Itineraries

# SQLite is a disposable cache; Render Free uses /tmp.
CACHE_DB_PATH=./data/train-cache.sqlite

# Optional: restrict the reviewed regional allowlist; never expands it.
# PILOT_STATION_IDS=brasov,codlea,cfr-20658

# Optional operational limits.
# API_REQUESTS_PER_MINUTE=60
# CFR_REQUESTS_PER_MINUTE=30
# CFR_MAX_CONCURRENT=2
# CFR_MAX_QUEUE=20
# Configure only when a trusted ingress overwrites this header; Render's public
# ingress uses Cloudflare's CF-Connecting-IP for per-client API rate limits.
# API_RATE_LIMIT_CLIENT_IP_HEADER=CF-Connecting-IP
# Generic self-hosting option: set only after verifying the exact proxy chain.
# TRUST_PROXY_HOPS=1
